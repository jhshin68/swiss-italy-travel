# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/backend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bkit 내부 상태 (세션별로 갱신되는 로컬 전용 파일 — 커밋 불필요)
.bkit/runtime/
.bkit/state/
.bkit/snapshots/

# 개인 자료 폴더
내폴더/

# SSH 키 및 보안 파일 (절대 커밋 금지)
*ssh key*
*ssh_key*

# IDE 및 Claude Code 로컬 설정
.vscode/settings.json
.claude/settings.local.json
.claude/settings.json

# Playwright MCP 로컬 테스트 파일
.playwright-mcp/

# 미리보기 스크린샷
preview-*.png

# next-pwa 자동 생성 파일 (빌드 시 생성됨)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map
.env*.local

# Playwright 테스트 결과 (로컬 전용)
playwright-report/
test-results/

# 백엔드 빌드 산출물
/backend/dist/

# 홈 화면 임시 스크린샷 (로컬 전용)
home-*.png
