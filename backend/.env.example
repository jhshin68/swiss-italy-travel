# ============================================================
# swiss-italy-travel API 환경변수 템플릿
# 실제 .env 파일은 절대 커밋하지 않는다.
# ============================================================

# 서버
PORT=3001
NODE_ENV=development

# SQLite DB 경로 (Oracle VM: /app/data/travel.db)
DB_PATH=./data/travel.db

# JWT 시크릿 (랜덤 32바이트 이상 문자열 권장)
JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=30d

# 가족 공통 PIN (6자리 숫자)
FAMILY_PIN=CHANGE_ME_6DIGIT

# CORS 허용 오리진 (Vercel 배포 URL)
CORS_ORIGIN=https://swiss-italy-travel.vercel.app

# 로그 레벨 (development: dev / production: combined)
LOG_FORMAT=dev
